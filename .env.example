# Token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# API key từ Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tùy chọn (có giá trị mặc định trong code)
GEMINI_MODEL=gemini-3.1-flash-lite
BOT_NAME=Mây
# SYSTEM_PROMPT=...   # override prompt nếu muốn đổi tính cách bot
# OWNER_ID=6664632552   # Telegram ID của "đại ca" (chế độ ưu tiên)
# ENABLE_SEARCH=true     # true = cho bot tra Google Search tin mới; false = tắt
# SYSTEM_PROMPT=...      # override prompt nếu muốn đổi tính cách bot
# PORT=3000
